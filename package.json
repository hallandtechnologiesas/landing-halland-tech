{
  "name": "halland-tech",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build",
    "dev": "astro dev",
    "format": "oxfmt . && prettier --write \"src/**/*.astro\"",
    "format:check": "oxfmt --check . && prettier --check \"src/**/*.astro\"",
    "lint": "oxlint --type-aware --deny-warnings astro.config.ts src",
    "lint:fix": "oxlint --type-aware --deny-warnings --fix astro.config.ts src",
    "preview": "astro preview",
    "typecheck": "astro check"
  },
  "dependencies": {
    "astro": "7.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.1",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "wrangler": "4.123.0"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "11.22.0"
  },
  "packageManager": "pnpm@11.22.0"
}
