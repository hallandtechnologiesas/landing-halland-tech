---
interface Props {
  legal?: boolean;
}

const { legal = false } = Astro.props;
const appStoreUrl = "https://apps.apple.com/us/app/rotile/id6751348002";
const email = "oscar@halland.tech";
---

<header class="flex min-h-7 items-start justify-between gap-5 sm:items-center sm:gap-8">
  <a
    class="max-w-36 text-lg leading-none font-semibold tracking-tight no-underline transition-colors hover:text-blue-600 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-600 motion-reduce:transition-none sm:max-w-none sm:text-xl"
    href="/"
    aria-label="Halland Technologies home"
  >
    Halland Technologies
  </a>

  <nav
    class="flex items-center gap-4 text-sm sm:gap-6 sm:text-base md:gap-10 lg:gap-16"
    aria-label="Primary navigation"
  >
    {
      legal && (
        <a
          class="hidden no-underline transition-colors hover:text-blue-600 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-600 motion-reduce:transition-none sm:inline"
          href="/"
        >
          Home
        </a>
      )
    }
    <a
      class="no-underline transition-colors hover:text-blue-600 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-600 motion-reduce:transition-none"
      href={appStoreUrl}
      target="_blank"
      rel="noreferrer"
    >
      RoTile
    </a>
    <a
      class="no-underline transition-colors hover:text-blue-600 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-600 motion-reduce:transition-none"
      href={`mailto:${email}`}>Contact</a
    >
  </nav>
</header>
