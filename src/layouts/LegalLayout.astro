---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  summary?: string;
}

const { title, description, eyebrow, heading, summary } = Astro.props;
---

<BaseLayout title={title} description={description} legal>
  <main
    class="mx-auto w-full max-w-3xl pt-24 pb-20 sm:pt-28 md:pt-36 lg:pt-40 lg:pb-36"
  >
    <header class="mb-16 md:mb-24 lg:mb-28">
      <p class="mb-4 text-xs font-semibold tracking-widest text-neutral-600 uppercase">
        {eyebrow}
      </p>
      <h1
        class="m-0 text-5xl leading-none font-semibold tracking-tighter sm:text-6xl md:text-7xl lg:text-8xl"
      >
        {heading}
      </h1>
      {
        summary && (
          <p class="mt-7 mb-0 max-w-2xl text-lg leading-relaxed text-neutral-800 md:text-xl">
            {summary}
          </p>
        )
      }
    </header>

    <article class="space-y-12 text-base leading-relaxed sm:text-lg">
      <slot />
    </article>
  </main>
</BaseLayout>
