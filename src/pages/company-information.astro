---
import LegalSection from "../components/LegalSection.astro";
import LegalLayout from "../layouts/LegalLayout.astro";
---

<LegalLayout
  title="Company Information | Halland Technologies"
  description="Legal and contact information for Halland Technologies AS."
  eyebrow="Company information"
  heading="Halland Technologies AS"
  summary="Legal and contact information."
>
  <LegalSection heading="Contact">
    <address class="not-italic">
      c/o Oscar Wold Halland
      <br />
      Nordre Kirkefjell 39
      <br />
      4843 Arendal
      <br />
      Norway
    </address>
    <div class="flex flex-col items-start gap-1">
      <a
        class="text-orange-700 underline decoration-1 underline-offset-4 transition-colors hover:text-orange-800 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-orange-600 motion-reduce:transition-none"
        href="mailto:oscar@halland.tech">oscar@halland.tech</a
      >
      <a
        class="text-orange-700 underline decoration-1 underline-offset-4 transition-colors hover:text-orange-800 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-orange-600 motion-reduce:transition-none"
        href="tel:+4741123664">+47 411 23 664</a
      >
    </div>
  </LegalSection>

  <LegalSection heading="Registration">
    <p>
      Halland Technologies AS, organization number 929 468 724, is registered in the
      Norwegian Register of Business Enterprises and the VAT Register.
    </p>
    <p>
      <a
        class="text-orange-700 underline decoration-1 underline-offset-4 transition-colors hover:text-orange-800 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-orange-600 motion-reduce:transition-none"
        href="https://virksomhet.brreg.no/nb/oppslag/enheter/929468724"
        target="_blank"
        rel="noreferrer"
      >
        View the official registration
      </a>
    </p>
  </LegalSection>
</LegalLayout>
