---
import LegalSection from "../components/LegalSection.astro";
import LegalLayout from "../layouts/LegalLayout.astro";
---

<LegalLayout
  title="Support | Halland Technologies"
  description="Get support for RoTile and other Halland Technologies products."
  eyebrow="RoTile support"
  heading="How can we help?"
  summary="Send a message if RoTile does not work as expected or if you have a question about the app."
>
  <LegalSection heading="Contact">
    <p>
      Email <a
        class="text-orange-700 underline decoration-1 underline-offset-4 transition-colors hover:text-orange-800 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-orange-600 motion-reduce:transition-none"
        href="mailto:oscar@halland.tech">oscar@halland.tech</a
      >. Include the iPhone model, iOS version, and a short description of the problem.
      Do not send private account details or passwords.
    </p>
  </LegalSection>

  <LegalSection heading="Widget does not update">
    <ol class="list-decimal space-y-2 pl-6">
      <li class="pl-1">Check that the Roblox experience URL is public and valid.</li>
      <li class="pl-1">Check the internet connection.</li>
      <li class="pl-1">Edit the widget and save its configuration again.</li>
      <li class="pl-1">
        Wait for iOS to request the next update. iOS controls the final widget refresh
        schedule.
      </li>
    </ol>
  </LegalSection>

  <LegalSection heading="Delete app data">
    <p>
      You can stop future analytics in the Privacy and Analytics screen in RoTile. You
      can also delete RoTile from the device. To ask us to delete analytics or support
      data that we can identify, email us.
    </p>
  </LegalSection>
</LegalLayout>
