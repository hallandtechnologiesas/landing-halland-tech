---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Halland Technologies"
  description="Native iOS apps, web products, and technical help from Arendal, Norway."
>
  <main
    class="flex flex-1 items-start overflow-clip pt-28 pb-20 sm:pt-36 md:pt-40 lg:pt-48 lg:pb-24"
  >
    <div class="w-full max-w-3xl">
      <h1
        class="m-0 max-w-3xl text-6xl leading-none font-semibold tracking-tighter sm:text-7xl md:text-8xl lg:text-9xl"
      >
        <span class="block w-max max-w-full">Software,</span>
        <span class="block w-max max-w-full">made useful.</span>
      </h1>
      <p
        class="mt-7 mb-0 max-w-2xl text-base leading-relaxed sm:mt-9 sm:text-lg md:text-xl"
      >
        Native iOS apps, web products, and technical help from Arendal, Norway.
      </p>
    </div>
  </main>
</BaseLayout>
